# Copy to .env.local. Never commit real keys. Only VITE_* vars reach the browser.
# Optional: NASA API key (https://api.nasa.gov). DEMO_KEY works with strict rate limits.
VITE_NASA_API_KEY=DEMO_KEY
# Optional: override map tile URL templates (see docs/DATA_SOURCES.md). Leave empty to use defaults in src/config/layers.config.ts
VITE_TILE_BASEMAP_URL=
VITE_TILE_ELEVATION_URL=
# UNVERIFIED candidate for the ELEVATION layer (MOLA shaded relief, 463 m/px, WMTS row order; layers.config sets tms:false). See docs/DATA_SOURCES.md section 7 and check it in T-001 first:
# VITE_TILE_ELEVATION_URL=https://trek.nasa.gov/tiles/Mars/EQ/Mars_MGS_MOLA_ClrShade_merge_global_463m/1.0.0/default/default028mm/{z}/{y}/{x}.jpg
# Phase 2 only (optional backend / AI assistant). Keep the secret key SERVER-SIDE, never as VITE_*.
# ANTHROPIC_API_KEY=
